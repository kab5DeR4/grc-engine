# GRC Engine Environment Configuration

# Backend API Configuration
GRC_HOST=127.0.0.1
GRC_PORT=8000
SECRET_KEY=super_secret_jwt_key_change_in_production_32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./grc_engine.db

# GitHub Connector Configuration
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_here

# AI / LLM Configuration (LiteLLM / OpenAI / Anthropic)
OPENAI_API_KEY=your_openai_api_key_here

# Frontend Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_DEMO_MODE=true
